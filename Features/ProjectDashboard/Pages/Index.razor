@page "/projects/{ProjectId:guid}/dashboard"
@using SmartLighting.Web.Features.ProjectDashboard.Components

<PageTitle>Dashboard do projeto</PageTitle>

<div class="project-dashboard-page container-fluid py-3 py-md-4">
    <div class="row mb-4">
        <div class="col-12">
            <RadzenBreadCrumb>
                <ChildContent>
                    <RadzenBreadCrumbItem Path="/" Text="Home" />
                    <RadzenBreadCrumbItem Path="/projects" Text="Projetos" />
                    <RadzenBreadCrumbItem Text="Dashboard do projeto" />
                </ChildContent>
            </RadzenBreadCrumb>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="row"><div class="col-12"><RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" /></div></div>
    }
    else if (isNotFound)
    {
        <div class="row"><div class="col-12 col-xl-10 col-xxl-8">
            <RadzenAlert AlertStyle="AlertStyle.Warning">O projeto solicitado não foi encontrado.</RadzenAlert>
        </div></div>
    }
    else if (errorMessage is not null)
    {
        <div class="row"><div class="col-12 col-xl-10 col-xxl-8">
            <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
        </div></div>
    }
    else if (projectDashboardVM is not null)
    {
        <div class="row align-items-center g-3 mb-4">
            <div class="col-12 col-md">
                <RadzenText TextStyle="TextStyle.H3" class="mb-1">@projectDashboardVM.Name</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-0">
                    Visão geral do projeto, seus controladores, zonas e telemetria.
                </RadzenText>
            </div>
            <div class="col-12 col-md-auto">
                <div class="d-flex flex-wrap gap-2">
                    <RadzenButton Text="Cadastrar dispositivo" Icon="add" ButtonStyle="ButtonStyle.Primary"
                                  Click="@CreateDevice" />
                    <RadzenButton Text="Atualizar" Icon="refresh" ButtonStyle="ButtonStyle.Light" Click="@LoadData" />
                </div>
            </div>
        </div>

        <div class="row g-3 g-xl-4 mb-4">
            <div class="col-12 col-md-6 col-xl-4">
                <div class="project-summary-card project-accent-contact h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3">
                            <div class="project-summary-icon"><RadzenIcon Icon="sensors" /></div>
                            <div class="min-width-0">
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-2">Último contato</RadzenText>
                                <RadzenText TextStyle="TextStyle.H5" class="project-summary-value mb-1">
                                    @(lastTelemetryAtUtc is null
                                        ? "Nenhum contato registrado"
                                        : ProjectDashboardDateFormatter.Format(lastTelemetryAtUtc.Value))
                                </RadzenText>
                                @if (lastTelemetryAtUtc is null)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">
                                        Sem confirmação de contato dos controladores
                                    </RadzenText>
                                }
                                else
                                {
                                    <div class="project-contact-status @(onlineDeviceCount > 0 ? "is-online" : "is-offline")">
                                        <span class="project-status-dot" aria-hidden="true"></span>
                                        <span>
                                            @(onlineDeviceCount > 0
                                                ? $"{onlineDeviceCount} de {projectDashboardVM.Devices.Count} controladores online"
                                                : "Nenhum controlador online")
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </RadzenCard>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-4">
                <div class="project-summary-card project-accent-luminaires h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3">
                            <div class="project-summary-icon"><RadzenIcon Icon="lightbulb" /></div>
                            <div class="min-width-0">
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-2">Luminárias</RadzenText>
                                <RadzenText TextStyle="TextStyle.H5" class="project-summary-value mb-1">
                                    @projectDashboardVM.Luminaires.Count cadastradas
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">
                                    @luminairesWithStateCount com estado recebido
                                </RadzenText>
                            </div>
                        </div>
                    </RadzenCard>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-4">
                <div class="project-summary-card project-accent-events h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3">
                            <div class="project-summary-icon"><RadzenIcon Icon="radar" /></div>
                            <div class="min-width-0">
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-2">Eventos dos sensores</RadzenText>
                                <RadzenText TextStyle="TextStyle.H5" class="project-summary-value mb-1">
                                    @(sensorEventsTotalCount is int count
                                        ? $"{count:N0} registrados"
                                        : sensorEventsLoadFinished ? "Indisponível" : "Carregando eventos")
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">
                                    Histórico do projeto disponível na tabela abaixo
                                </RadzenText>
                            </div>
                        </div>
                    </RadzenCard>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <div class="project-panel">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <RadzenIcon Icon="map" class="project-section-icon" />
                            <div>
                                <RadzenText TextStyle="TextStyle.H5" class="mb-1">Mapa de calor do projeto</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-0">
                                    @(IsMaqueteMap
                                        ? "Posições dos sensores e LEDs na maquete e registros por zona nas últimas 24 horas."
                                        : "Registros dos sensores por zona nas últimas 24 horas.")
                                </RadzenText>
                            </div>
                        </div>
                        @if (projectDashboardVM.Zones.Count == 0)
                        {
                            <p class="rz-text-secondary mb-0">Cadastre zonas para visualizar a atividade.</p>
                        }
                        else
                        {
                            <div class="@(IsMaqueteMap ? "project-map-layout" : "")">
                                @if (IsMaqueteMap)
                                {
                                    <div class="project-map-main">
                                        <div class="maquete-map" aria-label="Mapa da maquete com a posição dos seis sensores e dez LEDs">
                                            <img src="/images/maquete-mapa.png" alt="Vista superior da maquete com campo de futebol, ruas e casas" />
                                            @foreach (var marker in SensorMarkers)
                                            {
                                                var zone = GetMapZone(marker.Number);
                                                if (zone is not null)
                                                {
                                                    var sensorName = zone.Sensors.Single().Name;
                                                    <div class="maquete-marker maquete-sensor @GetZoneActivityClass(zone.ZoneId) @(marker.LabelBelow ? "label-below" : "label-above")"
                                                         style="@marker.Style"
                                                         title="@($"{sensorName} · {zone.Name}: {FormatZoneEventCount(zone.ZoneId)} nas últimas 24 horas")"
                                                         role="img"
                                                         aria-label="@($"{sensorName}, {zone.Name}, {FormatZoneEventCount(zone.ZoneId)} nas últimas 24 horas")">
                                                        <span class="maquete-heat-halo" aria-hidden="true"></span>
                                                        <span class="maquete-marker-label">@sensorName</span>
                                                    </div>
                                                }
                                            }
                                            @foreach (var marker in LuminaireMarkers)
                                            {
                                                var luminaire = GetMapLuminaire(marker.Number);
                                                if (luminaire is not null)
                                                {
                                                    <div class="maquete-marker maquete-led @(luminaire.BrightnessPercentage is > 0 ? "has-brightness" : "") @(luminaire.BrightnessPercentage is >= 50 ? "is-boosted" : "") @(marker.LabelBelow ? "label-below" : "label-above")"
                                                         style="@marker.Style"
                                                         title="@($"{luminaire.Name} · último brilho registrado: {FormatBrightness(luminaire)}")"
                                                         role="img"
                                                         aria-label="@($"{luminaire.Name}, último brilho registrado: {FormatBrightness(luminaire)}")">
                                                        <span class="maquete-marker-label">@luminaire.Name</span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <div class="maquete-map-legend">
                                            <span><b class="maquete-legend-sensor"></b> Sensores: manchas maiores e mais quentes mostram maior atividade</span>
                                            <span><b class="maquete-legend-led"></b> LEDs (último brilho registrado): cinza = 0% ou sem registro; amarelo = 1% a 49%; amarelo forte = 50% a 100%</span>
                                        </div>
                                    </div>
                                }
                                <div class="@(IsMaqueteMap ? "project-map-activity" : "")">
                                    <h3 class="project-heat-subtitle">Atividade por zona</h3>
                                    <div class="project-heat-grid">
                                        @foreach (var zone in projectDashboardVM.Zones.OrderBy(zone => zone.DisplayOrder))
                                        {
                                            <div class="project-heat-zone @GetZoneActivityClass(zone.ZoneId)">
                                                <strong>@zone.Name</strong>
                                                <span>@FormatZoneEventCount(zone.ZoneId)</span>
                                            </div>
                                        }
                                    </div>
                                    <p class="rz-text-secondary mt-3 mb-0">A cor compara o volume de registros entre as zonas neste período. Se não há registros recentes, as zonas aparecem sem atividade.</p>
                                </div>
                            </div>
                        }
                    </RadzenCard>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-12 col-xxl-6">
                <div class="project-panel h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <RadzenIcon Icon="memory" class="project-section-icon" />
                            <div>
                                <RadzenText TextStyle="TextStyle.H5" class="mb-1">Controladores</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-0">Último contato de cada ESP32.</RadzenText>
                            </div>
                        </div>
                        <ProjectDevicesTable Devices="@projectDashboardVM.Devices" OpenDevice="@OpenDevice" />
                    </RadzenCard>
                </div>
            </div>
            <div class="col-12 col-xxl-6">
                <div class="project-panel h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <RadzenIcon Icon="grid_view" class="project-section-icon" />
                            <div>
                                <RadzenText TextStyle="TextStyle.H5" class="mb-1">Zonas do projeto</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-0">Componentes configurados em cada área.</RadzenText>
                            </div>
                        </div>
                        <ProjectZonesTable Zones="@projectDashboardVM.Zones" />
                    </RadzenCard>
                </div>
            </div>
        </div>

        <div class="row g-4 align-items-stretch">
            <div class="col-12 col-xxl-6">
                <div class="project-panel h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <RadzenIcon Icon="lightbulb" class="project-section-icon" />
                            <div>
                                <RadzenText TextStyle="TextStyle.H5" class="mb-1">Estado das luminárias</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-0">Brilho conhecido por zona e controlador.</RadzenText>
                            </div>
                        </div>
                        <ProjectLuminaireStatesTable Luminaires="@projectDashboardVM.Luminaires" />
                    </RadzenCard>
                </div>
            </div>
            <div class="col-12 col-xxl-6">
                <div class="project-panel h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <RadzenIcon Icon="sensors" class="project-section-icon" />
                            <div>
                                <RadzenText TextStyle="TextStyle.H5" class="mb-1">Histórico dos sensores</RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-0">Registros dos controladores do projeto.</RadzenText>
                            </div>
                        </div>
                        <ProjectSensorEventsTable ProjectId="@ProjectId" Devices="@projectDashboardVM.Devices"
                                                  TotalCountChanged="@OnSensorEventsTotalCountChanged" />
                    </RadzenCard>
                </div>
            </div>
        </div>
    }
</div>

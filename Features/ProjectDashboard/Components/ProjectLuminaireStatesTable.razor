@using SmartLighting.Web.Features.ProjectDashboard.Contracts.ViewModels

@if (Luminaires.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">Este projeto não possui luminárias cadastradas.</RadzenAlert>
}
else
{
    <div class="overflow-auto">
        <RadzenDataGrid Data="@Luminaires" TItem="ProjectLuminaireVMList" AllowPaging="false" AllowSorting="false" Style="min-width: 780px;">
            <Columns>
                <RadzenDataGridColumn TItem="ProjectLuminaireVMList" Property="Name" Title="Luminária" />
                <RadzenDataGridColumn TItem="ProjectLuminaireVMList" Property="ZoneName" Title="Zonas" />
                <RadzenDataGridColumn TItem="ProjectLuminaireVMList" Property="DeviceName" Title="Controlador" />
                <RadzenDataGridColumn TItem="ProjectLuminaireVMList" Title="Brilho">
                    <Template Context="row">
                        @(row.BrightnessPercentage is null ? "Sem estado recebido" : $"{row.BrightnessPercentage}%")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ProjectLuminaireVMList" Title="Última atualização">
                    <Template Context="row">
                        @(row.UpdatedAtUtc is null
                            ? "Sem estado recebido"
                            : $"{ProjectDashboardDateFormatter.Format(row.UpdatedAtUtc.Value)} (horário)")
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
}

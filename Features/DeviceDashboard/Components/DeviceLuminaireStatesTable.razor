@using SmartLighting.Web.Features.DeviceDashboard.Contracts.ViewModels

@if (Luminaires.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        Este dispositivo não possui luminárias cadastradas.
    </RadzenAlert>
}
else
{
    <div class="overflow-auto">
        <RadzenDataGrid Data="@Luminaires" TItem="DeviceLuminaireStateVMList" AllowPaging="false" AllowSorting="false" Style="min-width: 620px;">
            <Columns>
                <RadzenDataGridColumn TItem="DeviceLuminaireStateVMList" Property="LuminaireName" Title="Luminária" />
                <RadzenDataGridColumn TItem="DeviceLuminaireStateVMList" Property="ZoneName" Title="Zona" />

                <RadzenDataGridColumn TItem="DeviceLuminaireStateVMList" Title="Brilho">
                    <Template Context="row">
                        @(row.BrightnessPercentage is null ? "Sem estado recebido" : $"{row.BrightnessPercentage}%")
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="DeviceLuminaireStateVMList" Title="Última atualização">
                    <Template Context="row">
                        @(row.UpdatedAtUtc is null
                            ? "Sem estado recebido"
                            : $"{DeviceDashboardDateFormatter.Format(row.UpdatedAtUtc.Value)} (horário de Brasília)")
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
}

@page "/devices/{DeviceId:guid}"
@using SmartLighting.Web.Features.Dashboard.Components

<PageTitle>Dashboard do dispositivo</PageTitle>

<div class="dashboard-page container-fluid py-3 py-md-4">
    <div class="row mb-4">
        <div class="col-12">
            <RadzenBreadCrumb>
                <ChildContent>
                    <RadzenBreadCrumbItem Path="/" Text="Home" />
                    <RadzenBreadCrumbItem Path="/devices" Text="Dispositivos" />
                    <RadzenBreadCrumbItem Text="Dashboard" />
                </ChildContent>
            </RadzenBreadCrumb>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="row">
            <div class="col-12">
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
            </div>
        </div>
    }
    else if (isNotFound)
    {
        <div class="row">
            <div class="col-12 col-xl-10 col-xxl-8">
                <RadzenAlert AlertStyle="AlertStyle.Warning">
                    O dispositivo solicitado não foi encontrado.
                </RadzenAlert>

                <RadzenButton Text="Voltar para dispositivos"
                              Icon="arrow_back"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@NavigateToDevices" />
            </div>
        </div>
    }
    else if (errorMessage is not null)
    {
        <div class="row">
            <div class="col-12 col-xl-10 col-xxl-8">
                <RadzenAlert AlertStyle="AlertStyle.Danger">
                    @errorMessage
                </RadzenAlert>
            </div>
        </div>
    }
    else if (dashboardVM is not null)
    {
        <div class="row align-items-center g-3 mb-4">
            <div class="col-12 col-md">
                <RadzenText TextStyle="TextStyle.H3" class="mb-1">
                    @dashboardVM.Name
                </RadzenText>

                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-1">
                    Visão operacional da maquete e dos dados recebidos dos sensores.
                </RadzenText>

                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">
                    ID: @dashboardVM.DeviceId
                </RadzenText>
            </div>

            <div class="col-12 col-md-auto">
                <RadzenButton Text="Atualizar"
                              Icon="refresh"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@LoadData" />
            </div>
        </div>

        <div class="row g-3 g-xl-4 mb-4">
            <div class="col-12 col-md-6 col-xl-3">
                <div class="dashboard-summary-card dashboard-accent-contact h-100">
                    <LastTelemetryCard LastTelemetryAtUtc="@dashboardVM.LastTelemetryAtUtc" />
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="dashboard-summary-card dashboard-accent-luminaires h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3">
                            <div class="dashboard-summary-icon">
                                <RadzenIcon Icon="lightbulb" />
                            </div>
                            <div class="min-width-0">
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-2">
                                    Luminárias
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.H5" class="dashboard-summary-value mb-1">
                                    @dashboardVM.Luminaires.Count cadastradas
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">
                                    @luminairesWithStateCount com estado recebido
                                </RadzenText>
                            </div>
                        </div>
                    </RadzenCard>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="dashboard-summary-card dashboard-accent-events h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3">
                            <div class="dashboard-summary-icon">
                                <RadzenIcon Icon="sensors" />
                            </div>
                            <div class="min-width-0">
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-2">
                                    Eventos recentes
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.H5" class="dashboard-summary-value mb-1">
                                    @dashboardVM.RecentSensorEvents.Count exibidos
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">
                                    Até 50 eventos mais recentes
                                </RadzenText>
                            </div>
                        </div>
                    </RadzenCard>
                </div>
            </div>

            <div class="col-12 col-md-6 col-xl-3">
                <div class="dashboard-summary-card dashboard-accent-savings h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3">
                            <div class="dashboard-summary-icon">
                                <RadzenIcon Icon="energy_savings_leaf" />
                            </div>
                            <div class="min-width-0">
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-2">
                                    Economia de energia
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.H5" class="dashboard-summary-value mb-1">
                                    Ainda não implementado
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">
                                    Estimativa de economia da maquete em desenvolvimento
                                </RadzenText>
                            </div>
                        </div>
                    </RadzenCard>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-12">
                <div class="dashboard-panel">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <RadzenIcon Icon="map" class="dashboard-section-icon" />
                            <div>
                                <RadzenText TextStyle="TextStyle.H5" class="mb-1">
                                    Mapa de calor da maquete
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-0">
                                    Espaço reservado para visualizar a atividade dos sensores na maquete.
                                </RadzenText>
                            </div>
                        </div>

                        <div class="dashboard-map-placeholder d-flex flex-column align-items-center justify-content-center text-center">
                            <RadzenIcon Icon="grid_on" class="dashboard-placeholder-icon mb-3" />
                            <RadzenText TextStyle="TextStyle.H5" class="mb-1">
                                Mapa de calor da maquete
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-0">
                                Visualização em preparação
                            </RadzenText>
                        </div>
                    </RadzenCard>
                </div>
            </div>
        </div>

        <div class="row g-4 align-items-stretch">
            <div class="col-12 col-xxl-6">
                <div class="dashboard-panel h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <RadzenIcon Icon="lightbulb" class="dashboard-section-icon" />
                            <div>
                                <RadzenText TextStyle="TextStyle.H5" class="mb-1">
                                    Estado das luminárias
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-0">
                                    Brilho e última atualização recebidos de cada luminária.
                                </RadzenText>
                            </div>
                        </div>

                        <LuminaireStatesTable Luminaires="@dashboardVM.Luminaires" />
                    </RadzenCard>
                </div>
            </div>

            <div class="col-12 col-xxl-6">
                <div class="dashboard-panel h-100">
                    <RadzenCard>
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <RadzenIcon Icon="sensors" class="dashboard-section-icon" />
                            <div>
                                <RadzenText TextStyle="TextStyle.H5" class="mb-1">
                                    Eventos recentes dos sensores
                                </RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-0">
                                    Últimas detecções recebidas dos sensores.
                                </RadzenText>
                            </div>
                        </div>

                        <RecentSensorEventsTable Events="@dashboardVM.RecentSensorEvents" />
                    </RadzenCard>
                </div>
            </div>
        </div>
    }
</div>

@page "/devices/{DeviceId:guid}"
@using SmartLighting.Web.Features.Devices.Dashboard.Components

<PageTitle>Dashboard do dispositivo</PageTitle>

<div class="container-fluid py-3 py-md-4">
    <div class="row mb-4">
        <div class="col-12">
            <RadzenBreadCrumb>
                <ChildContent>
                    <RadzenBreadCrumbItem Path="/" Text="Home" />
                    <RadzenBreadCrumbItem Path="/devices" Text="Dispositivos" />
                    <RadzenBreadCrumbItem Text="Dashboard" />
                </ChildContent>
            </RadzenBreadCrumb>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="row">
            <div class="col-12 col-xl-10 col-xxl-8">
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
            </div>
        </div>
    }
    else if (isNotFound)
    {
        <div class="row">
            <div class="col-12 col-xl-10 col-xxl-8">
                <RadzenAlert AlertStyle="AlertStyle.Warning">
                    O dispositivo solicitado não foi encontrado.
                </RadzenAlert>

                <RadzenButton Text="Voltar para dispositivos"
                              Icon="arrow_back"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@NavigateToDevices" />
            </div>
        </div>
    }
    else if (dashboardError is not null)
    {
        <div class="row">
            <div class="col-12 col-xl-10 col-xxl-8">
                <RadzenAlert AlertStyle="AlertStyle.Danger">
                    @dashboardError
                </RadzenAlert>
            </div>
        </div>
    }
    else if (topology is not null)
    {
        <div class="row align-items-center g-3 mb-4">
            <div class="col">
                <RadzenText TextStyle="TextStyle.H3">
                    @topology.Name
                </RadzenText>

                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary">
                    ID: @topology.DeviceId
                </RadzenText>
            </div>

            <div class="col-auto">
                <RadzenButton Text="Atualizar"
                              Icon="refresh"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@LoadData" />
            </div>
        </div>

        <div class="row g-4">
            <div class="col-12 col-xl-10 col-xxl-8">
                @if (dashboard!.TelemetryStatus.Data is not null)
                {
                    <LastTelemetryCard LastTelemetryAtUtc="@dashboard.TelemetryStatus.Data.LastTelemetryAtUtc" />
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger">
                        @dashboard!.TelemetryStatus.ErrorMessage
                    </RadzenAlert>
                }
            </div>

            <div class="col-12">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H5" class="mb-3">
                        Estado das luminárias
                    </RadzenText>

                    @if (dashboard!.LuminaireStates.Data is not null)
                    {
                        <LuminaireStatesTable Topology="@topology" States="@dashboard.LuminaireStates.Data" />
                    }
                    else
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger">
                            @dashboard!.LuminaireStates.ErrorMessage
                        </RadzenAlert>
                    }
                </RadzenCard>
            </div>

            <div class="col-12">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H5" class="mb-3">
                        Eventos recentes dos sensores
                    </RadzenText>

                    @if (dashboard!.RecentSensorEvents.Data is not null)
                    {
                        <RecentSensorEventsTable Topology="@topology" Events="@dashboard.RecentSensorEvents.Data" />
                    }
                    else
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Danger">
                            @dashboard!.RecentSensorEvents.ErrorMessage
                        </RadzenAlert>
                    }
                </RadzenCard>
            </div>
        </div>
    }
</div>

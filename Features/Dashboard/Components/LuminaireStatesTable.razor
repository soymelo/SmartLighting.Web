@using SmartLighting.Web.Features.Dashboard.Contracts.ViewModels

@if (Luminaires.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        Este dispositivo não possui luminárias cadastradas.
    </RadzenAlert>
}
else
{
    <RadzenDataGrid Data="@Luminaires" TItem="LuminaireStateVMList" AllowPaging="false" AllowSorting="false">
        <Columns>
            <RadzenDataGridColumn TItem="LuminaireStateVMList" Property="LuminaireName" Title="Luminária" />
            <RadzenDataGridColumn TItem="LuminaireStateVMList" Property="ZoneName" Title="Zona" />

            <RadzenDataGridColumn TItem="LuminaireStateVMList" Title="Brilho">
                <Template Context="row">
                    @(row.BrightnessPercentage is null ? "Sem estado recebido" : $"{row.BrightnessPercentage}%")
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="LuminaireStateVMList" Title="Última atualização">
                <Template Context="row">
                    @(row.UpdatedAtUtc is null
                        ? "Sem estado recebido"
                        : $"{DashboardDateFormatter.Format(row.UpdatedAtUtc.Value)} (horário de Brasília)")
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

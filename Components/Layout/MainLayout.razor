@inherits LayoutComponentBase

<RadzenLayout>
    <RadzenHeader>
        <div class="container-fluid">
            <div class="row align-items-center py-2">
                <div class="col-auto">
                    <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
                </div>

                <div class="col">
                    <RadzenText TextStyle="TextStyle.H6">
                        Smart Lighting
                    </RadzenText>
                </div>
            </div>
        </div>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="sidebarExpanded">
        <RadzenPanelMenu>
            <RadzenPanelMenuItem Text="Home"
                                 Icon="home"
                                 Path="/" />

            <RadzenPanelMenuItem Text="Dispositivos"
                                 Icon="memory"
                                 Path="/devices" />
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    @Body
                </div>
            </div>
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    private bool sidebarExpanded = true;
}
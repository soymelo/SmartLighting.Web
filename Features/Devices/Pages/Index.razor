@page "/devices"

<PageTitle>Dispositivos</PageTitle>

<div class="container-fluid py-3 py-md-4">

    <div class="row mb-4">
        <div class="col-12">
            <RadzenBreadCrumb>
                <ChildContent>
                    <RadzenBreadCrumbItem Path="/" Text="Home" />
                    <RadzenBreadCrumbItem Path="/devices" Text="Dispositivos" />
                </ChildContent>
            </RadzenBreadCrumb>
        </div>
    </div>

    <div class="row align-items-center g-3 mb-4">
        <div class="col">
            <RadzenText TextStyle="TextStyle.H3">
                Dispositivos
            </RadzenText>

            <RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary">
                Acompanhe os dispositivos responsáveis pela coleta de telemetria.
            </RadzenText>
        </div>

        <div class="col-auto">
            <RadzenButton Text="Atualizar"
                          Icon="refresh"
                          ButtonStyle="ButtonStyle.Light"
                          Click="@LoadDevicesAsync"
                          Disabled="@isLoading" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="row">
            <div class="col-12 col-xl-10 col-xxl-8">
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
            </div>
        </div>
    }
    else if (errorMessage is not null)
    {
        <div class="row">
            <div class="col-12 col-xl-10 col-xxl-8">
                <RadzenAlert AlertStyle="AlertStyle.Danger">
                    @errorMessage
                </RadzenAlert>
            </div>
        </div>
    }
    else if (devices.Count == 0)
    {
        <div class="row">
            <div class="col-12 col-xl-10 col-xxl-8">
                <RadzenAlert AlertStyle="AlertStyle.Info">
                    Nenhum dispositivo cadastrado.
                </RadzenAlert>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-12 col-xl-10 col-xxl-8">
                <RadzenBadge Text="@(devices.Count == 1 ? "1 dispositivo cadastrado" : $"{devices.Count} dispositivos cadastrados")"
                             BadgeStyle="BadgeStyle.Info" />
            </div>
        </div>

        <div class="row">
            <div class="col-12 col-xl-10 col-xxl-8">
                @foreach (var device in devices)
                {
                    <RadzenCard class="mb-3">
                        <div class="row align-items-center g-4">
                            <div class="col-md">
                                <div class="d-flex align-items-start gap-3">
                                    <RadzenIcon Icon="developer_board" Style="font-size: 2.25rem;" />

                                    <div>
                                        <RadzenText TextStyle="TextStyle.H5" class="mb-1">
                                            @device.Name
                                        </RadzenText>

                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary">
                                            Dispositivo responsável pela coleta de telemetria.
                                        </RadzenText>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-auto">
                                <RadzenButton Text="Abrir painel"
                                              Icon="dashboard"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Click="@(() => OpenDashboard(device.DeviceId))" />
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="row g-4">
                            <div class="col-12">
                                <div class="d-flex align-items-start gap-2">
                                    <RadzenIcon Icon="schedule" />

                                    <div>
                                        <RadzenText TextStyle="TextStyle.Overline" class="rz-text-secondary">
                                            Último contato
                                        </RadzenText>

                                        <RadzenText TextStyle="TextStyle.Body1">
                                            @FormatLastTelemetry(device.LastTelemetryAtUtc)
                                        </RadzenText>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col">
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary">
                                    ID: @device.DeviceId
                                </RadzenText>
                            </div>
                        </div>
                    </RadzenCard>
                }
            </div>
        </div>
    }

</div>

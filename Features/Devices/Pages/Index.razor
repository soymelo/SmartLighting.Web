@page "/devices/{DeviceId:guid}"
@using SmartLighting.Web.Features.Devices.Components

<PageTitle>Detalhes do dispositivo</PageTitle>

<div class="device-details-page container-fluid py-3 py-md-4">
    <div class="row mb-4">
        <div class="col-12">
            <RadzenBreadCrumb>
                <ChildContent>
                    <RadzenBreadCrumbItem Path="/" Text="Home" />
                    <RadzenBreadCrumbItem Path="/projects" Text="Projetos" />
                    @if (device is not null)
                    {
                        <RadzenBreadCrumbItem Path="@($"/projects/{device.ProjectId}/dashboard")" Text="@device.ProjectName" />
                    }
                    <RadzenBreadCrumbItem Text="Dispositivo" />
                </ChildContent>
            </RadzenBreadCrumb>
        </div>
    </div>

    @if (isLoading)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
    }
    else if (isNotFound)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning">O dispositivo solicitado não foi encontrado.</RadzenAlert>
        <RadzenButton Text="Voltar para projetos" Icon="arrow_back" ButtonStyle="ButtonStyle.Light"
                      Click="@NavigateToProjects" />
    }
    else if (errorMessage is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger">@errorMessage</RadzenAlert>
    }
    else if (device is not null)
    {
        <section class="device-hero mb-4">
            <div class="row align-items-center g-4">
                <div class="col-12 col-lg">
                    <div class="d-flex align-items-start gap-3 gap-md-4">
                        <div class="device-hero-icon">
                            <RadzenIcon Icon="developer_board" />
                        </div>
                        <div class="min-width-0">
                            <RadzenText TextStyle="TextStyle.Overline" class="device-eyebrow mb-1">
                                Controlador ESP32
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.H3" class="device-title mb-2">@device.Name</RadzenText>
                            <div class="device-project-reference">
                                <RadzenIcon Icon="location_city" />
                                <span>Projeto @device.ProjectName</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-auto">
                    <div class="device-actions d-flex flex-wrap gap-2">
                        <RadzenButton Text="Dashboard do projeto" Icon="dashboard" ButtonStyle="ButtonStyle.Primary"
                                      Click="@NavigateToProjectDashboard" />
                        <RadzenButton Text="Atualizar" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                                      Click="@LoadData" Disabled="@isLoading" />
                    </div>
                </div>
            </div>
            <div class="device-identifier mt-4">
                <span>ID do dispositivo</span>
                <code>@device.DeviceId</code>
            </div>
        </section>

        <div class="row g-3 g-xl-4 mb-5">
            <div class="col-12 col-md-4">
                <div class="device-summary-card h-100">
                    <div class="summary-icon summary-project"><RadzenIcon Icon="location_city" /></div>
                    <div class="min-width-0">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-1">Projeto</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" class="summary-value mb-0">@device.ProjectName</RadzenText>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="device-summary-card h-100">
                    <div class="summary-icon summary-contact"><RadzenIcon Icon="schedule" /></div>
                    <div class="min-width-0">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-1">Último contato</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" class="summary-value mb-1">
                        @(device.LastTelemetryAtUtc is null
                            ? "Nenhuma telemetria recebida"
                            : DeviceDateFormatter.Format(device.LastTelemetryAtUtc.Value))
                        </RadzenText>
                        @if (device.LastTelemetryAtUtc is not null)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">Horário de Brasília</RadzenText>
                        }
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="device-summary-card h-100">
                    <div class="summary-icon summary-components"><RadzenIcon Icon="account_tree" /></div>
                    <div class="min-width-0">
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-1">Componentes</RadzenText>
                        <RadzenText TextStyle="TextStyle.H5" class="summary-value mb-1">
                            @(device.Zones.Sum(zone => zone.Sensors.Count) + device.Zones.Sum(zone => zone.Luminaires.Count)) vinculados
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">
                            @device.Zones.Count @(device.Zones.Count == 1 ? "zona" : "zonas")
                        </RadzenText>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-heading mb-3">
            <div>
                <RadzenText TextStyle="TextStyle.H4" class="mb-1">Componentes por zona</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary mb-0">
                    Sensores e luminárias sob responsabilidade deste controlador.
                </RadzenText>
            </div>
        </div>
        @if (device.Zones.Count == 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info">Este dispositivo não possui sensores ou luminárias vinculados.</RadzenAlert>
        }
        else
        {
            <div class="row g-3">
                @foreach (var zone in device.Zones.OrderBy(zone => zone.DisplayOrder).ThenBy(zone => zone.ZoneId))
                {
                    <div class="col-12 col-xl-6">
                        <section class="zone-card h-100">
                            <header class="zone-header">
                                <div class="zone-icon"><RadzenIcon Icon="grid_view" /></div>
                                <div class="min-width-0">
                                    <RadzenText TextStyle="TextStyle.Overline" class="rz-text-secondary mb-0">Zona @zone.DisplayOrder</RadzenText>
                                    <RadzenText TextStyle="TextStyle.H5" class="mb-0">@zone.Name</RadzenText>
                                </div>
                                <div class="zone-total">
                                    @(zone.Sensors.Count + zone.Luminaires.Count)
                                    <span>itens</span>
                                </div>
                            </header>
                            <div class="row g-3 zone-content">
                                <div class="col-12 col-md-6">
                                    <div class="component-group component-group-sensors h-100">
                                        <div class="component-group-header">
                                            <div class="component-group-icon"><RadzenIcon Icon="sensors" /></div>
                                            <div>
                                                <RadzenText TextStyle="TextStyle.Subtitle2" class="mb-0">Sensores</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">
                                                    @zone.Sensors.Count @(zone.Sensors.Count == 1 ? "vinculado" : "vinculados")
                                                </RadzenText>
                                            </div>
                                        </div>
                                    @if (zone.Sensors.Count == 0)
                                    {
                                        <div class="component-empty">Nenhum sensor nesta zona</div>
                                    }
                                    else
                                    {
                                        <div class="component-list">
                                            @foreach (var sensor in zone.Sensors)
                                            {
                                                <div class="component-item">
                                                    <RadzenIcon Icon="sensors" />
                                                    <span>@sensor.Name</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    </div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="component-group component-group-luminaires h-100">
                                        <div class="component-group-header">
                                            <div class="component-group-icon"><RadzenIcon Icon="lightbulb" /></div>
                                            <div>
                                                <RadzenText TextStyle="TextStyle.Subtitle2" class="mb-0">Luminárias</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary mb-0">
                                                    @zone.Luminaires.Count @(zone.Luminaires.Count == 1 ? "vinculada" : "vinculadas")
                                                </RadzenText>
                                            </div>
                                        </div>
                                    @if (zone.Luminaires.Count == 0)
                                    {
                                        <div class="component-empty">Nenhuma luminária nesta zona</div>
                                    }
                                    else
                                    {
                                        <div class="component-list">
                                            @foreach (var luminaire in zone.Luminaires)
                                            {
                                                <div class="component-item">
                                                    <RadzenIcon Icon="lightbulb" />
                                                    <span>@luminaire.Name</span>
                                                    <span class="component-meta">@luminaire.NominalPowerWatts W</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                }
            </div>
        }
    }
</div>

@using SmartLighting.Web.Features.ProjectDashboard.Contracts.ViewModels

@if (Events.Count == 0)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">Nenhuma detecção de sensor recebida neste projeto.</RadzenAlert>
}
else
{
    <div class="overflow-auto">
        <RadzenDataGrid Data="@Events" TItem="ProjectSensorEventVMList" AllowPaging="false" AllowSorting="false" Style="min-width: 560px;">
            <Columns>
                <RadzenDataGridColumn TItem="ProjectSensorEventVMList" Property="SensorName" Title="Sensor" Width="120px" />
                <RadzenDataGridColumn TItem="ProjectSensorEventVMList" Property="ZoneName" Title="Zona" Width="100px" />
                <RadzenDataGridColumn TItem="ProjectSensorEventVMList" Property="DeviceName" Title="Controlador" Width="145px" />
                <RadzenDataGridColumn TItem="ProjectSensorEventVMList" Title="Data e hora" Width="165px">
                    <Template Context="row">
                        @ProjectDashboardDateFormatter.Format(row.OccurredAtUtc)
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
}
